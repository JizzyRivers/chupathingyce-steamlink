+BOOL platform_offer_game_data(const char *destination)
+{
+	char image[1100];
+	char error[512];
+	unsigned long long written = 0;
+
+	if (config_boolean("debug.hidden_window") || config_real("debug.exit_after") > 0.0)
+		return FALSE;
+	if (!SDL_Init(SDL_INIT_VIDEO))
+		return FALSE;
+	if (!steamlink_find_image(destination, image, sizeof(image)))
+	{
+		steamlink_notice("No Halo: Combat Evolved Xbox disc image found.",
+			"Put your .iso on the root of a USB stick, plug it in, and start this again.");
+		exit(EXIT_SUCCESS);
+	}
+	platform_log("importing maps from %s to %s", image, destination);
+	if (!data_extract(_data_xbox_disc, image, destination, &written, error, sizeof(error)))
+	{
+		steamlink_notice("The maps could not be copied from the disc image:", error);
+		exit(EXIT_SUCCESS);
+	}
+	platform_log("extracted the maps folder");
+	return TRUE;
+}
