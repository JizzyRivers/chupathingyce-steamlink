+#ifdef HALO_STEAMLINK
+/* the Steam Link has no dialogs or file picker: a disc image in the folder
+above the destination, the root of the player's USB stick (the app's run.sh
+mounts it), is found by itself, and anything else is said on the screen for
+as long as it takes to read or until a button is pressed */
+static BOOL steamlink_find_image(const char *destination, char *image, int size)
+{
+	char folder[1024];
+	char *slash;
+	DIR *directory;
+	struct dirent *entry;
+	BOOL found = FALSE;
+
+	snprintf(folder, sizeof(folder), "%s", destination);
+	slash = strrchr(folder, '/');
+	if (slash && slash != folder)
+		*slash = '\0';
+	directory = opendir(folder);
+	if (!directory)
+		return FALSE;
+	while (!found && (entry = readdir(directory)) != NULL)
+	{
+		const char *dot = strrchr(entry->d_name, '.');
+
+		if (!dot || (SDL_strcasecmp(dot, ".iso") && SDL_strcasecmp(dot, ".xiso")))
+			continue;
+		snprintf(image, (size_t)size, "%s/%s", folder, entry->d_name);
+		found = xiso_is_image(image) != 0;
+	}
+	closedir(directory);
+	return found;
+}
+
+void steamlink_notice(const char *first, const char *second)
+{
+	SDL_Window *window;
+	SDL_Renderer *renderer;
+	SDL_Texture *ring = NULL;
+	Uint64 start = SDL_GetTicks();
+	BOOL finished = FALSE;
+
+	platform_log("%s %s", first, second);
+	SDL_InitSubSystem(SDL_INIT_GAMEPAD);
+	window = steamlink_screen(&renderer);
+	if (!renderer)
+		return;
+	while (!finished && SDL_GetTicks() - start < 60000)
+	{
+		SDL_Event event;
+
+		while (SDL_PollEvent(&event))
+		{
+			if (event.type == SDL_EVENT_GAMEPAD_ADDED)
+				SDL_OpenGamepad(event.gdevice.which);
+			else if (event.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN || event.type == SDL_EVENT_KEY_DOWN ||
+				event.type == SDL_EVENT_QUIT)
+				finished = TRUE;
+		}
+		screen_ring(renderer, &ring, 0.0f, 0);
+		screen_text(renderer, POSIX_UI_FONT_MENU, 12.0f, 320.0f, 250.0f, 0, 0xffffff, 0, first);
+		screen_text(renderer, POSIX_UI_FONT_MENU_SMALL, 10.0f, 320.0f, 274.0f, 0, 0xa8ccff, 0, second);
+		screen_button(renderer, 280.0f, 308.0f, "A", 0x5cc24a, "CONTINUE");
+		SDL_RenderPresent(renderer);
+		SDL_Delay(50);
+	}
+	steamlink_text_forget();
+	if (ring)
+		SDL_DestroyTexture(ring);
+	SDL_DestroyRenderer(renderer);
+	SDL_DestroyWindow(window);
+}
