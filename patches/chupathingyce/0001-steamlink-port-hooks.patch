+/* Custom Edition's maps, optional, from its installer on the stick beside the
+disc image (whatever it is called: it is told by what it holds), once: they
+are what its servers' maps are played with */
+static void steamlink_offer_custom_edition(const char *destination)
+{
+	char folder[1024];
+	char maps_ce[1100];
+	char on_disk[256];
+	char installer[1400];
+	char *slash;
+	DIR *directory;
+	struct dirent *entry;
+	BOOL found = FALSE;
+
+	snprintf(maps_ce, sizeof(maps_ce), "%s/maps_ce", destination);
+	if (posix_find_entry_case_insensitive(maps_ce, "bitmaps.map", on_disk, sizeof(on_disk)))
+		return;
+	snprintf(folder, sizeof(folder), "%s", destination);
+	slash = strrchr(folder, '/');
+	if (slash && slash != folder)
+		*slash = '\0';
+	directory = opendir(folder);
+	if (!directory)
+		return;
+	while (!found && (entry = readdir(directory)) != NULL)
+	{
+		const char *dot = strrchr(entry->d_name, '.');
+
+		if (!dot || SDL_strcasecmp(dot, ".exe"))
+			continue;
+		snprintf(installer, sizeof(installer), "%s/%s", folder, entry->d_name);
+		found = ce_installer_is_installer(installer) != 0;
+	}
+	closedir(directory);
+	if (found)
+	{
+		char error[512];
+		unsigned long long written = 0;
+
+		platform_log("importing Custom Edition's maps from %s to %s", installer, destination);
+		if (data_extract(_data_custom_edition_installer, installer, destination, &written, error, sizeof(error)))
+			platform_log("imported %llu MB of maps into %s", written >> 20, maps_ce);
+		else
+			steamlink_notice("Custom Edition's maps could not be copied from its installer:", error);
+	}
+}
